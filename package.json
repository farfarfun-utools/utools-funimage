{
  "name": "@farfarfun/utools-funimage",
  "funbuild": {
    "build": "sh build.sh"
  },
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "图片工坊：本地批量编辑、转换与合并图片",
  "keywords": [
    "utools",
    "utools-plugin",
    "funimage",
    "image",
    "image-compression",
    "watermark",
    "gif",
    "pdf",
    "canvas",
    "offline",
    "farfarfun"
  ],
  "homepage": "https://farfarfun.github.io/packages/utools-funimage/",
  "repository": "https://github.com/farfarfun-utools/utools-funimage",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "check": "node --check src/app.js && node --check src/gif-frame.mjs && node --check src/image-helpers.mjs && node --check src/queue.mjs && node --check utools/preload.js && node --check utools/tasks.js && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "vite": "7.3.7"
  }
}
